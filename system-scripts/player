#!/usr/bin/env bash

if ! command -v playerctl >/dev/null 2>&1; then
    printf '%s\n' "Unavailable"
    exit 1
fi

case "${1:-status}" in
    status)
        if ! playerctl status >/dev/null 2>&1; then
            printf '%s\n' "No player"
            exit 0
        fi

        status=$(playerctl status 2>/dev/null)
        artist=$(playerctl metadata artist 2>/dev/null)
        title=$(playerctl metadata title 2>/dev/null)

        if [ -n "$artist" ] && [ -n "$title" ]; then
            printf '%s - %s [%s]\n' "$artist" "$title" "$status"
        elif [ -n "$title" ]; then
            printf '%s [%s]\n' "$title" "$status"
        else
            printf '%s\n' "$status"
        fi
        ;;

    player)
        playerctl metadata --format '{{playerName}}' 2>/dev/null
        ;;

    title)
        playerctl metadata title 2>/dev/null
        ;;

    artist)
        playerctl metadata artist 2>/dev/null
        ;;

    play|pause|play-pause|next|previous|stop)
        playerctl "$1"
        ;;

    *)
        printf 'Usage: %s {status|player|title|artist|play|pause|play-pause|next|previous|stop}\n' "$0" >&2
        exit 1
        ;;
esac
