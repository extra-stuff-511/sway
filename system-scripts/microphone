#!/usr/bin/env bash

case "${1:-status}" in
    status)
        wpctl get-volume @DEFAULT_AUDIO_SOURCE@ |
            awk '{
                muted = ($3 == "[MUTED]")
                if (muted)
                    printf "Muted\n"
                else
                    printf "%.0f%%\n", $2 * 100
            }'
        ;;

    mute|toggle)
        wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
        ;;

    unmute)
        wpctl set-mute @DEFAULT_AUDIO_SOURCE@ 0
        ;;

    set)
        if [[ "$2" =~ ^[0-9]+%$ ]]; then
            wpctl set-volume @DEFAULT_AUDIO_SOURCE@ "$2"
        else
            printf 'Usage: %s set <percentage>\n' "$0" >&2
            exit 1
        fi
        ;;

    *)
        printf 'Usage: %s {status|mute|toggle|unmute|set}\n' "$0" >&2
        exit 1
        ;;
esac
