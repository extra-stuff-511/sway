#!/usr/bin/env bash

case "${1:-status}" in
    status)
        # Mako does not expose a persistent notification count.
        # Use the current mode as the reliable status indicator.
        makoctl mode
        ;;

    dismiss)
        makoctl dismiss
        ;;

    dismiss-all)
        makoctl dismiss --all
        ;;

    mode)
        makoctl mode
        ;;

    mode-do-not-disturb|dnd)
        makoctl mode -a do-not-disturb
        ;;

    mode-default)
        makoctl mode -r do-not-disturb
        ;;

    *)
        printf 'Usage: %s {status|dismiss|dismiss-all|mode|dnd|mode-default}\n' "$0" >&2
        exit 1
        ;;
esac
