#!/usr/bin/env bash

case "${1:-status}" in
    status)
        wpctl get-volume @DEFAULT_AUDIO_SINK@ |
            awk '{
                volume = $2 * 100
                muted = ($3 == "[MUTED]")
                if (muted)
                    printf "Muted\n"
                else
                    printf "%.0f%%\n", volume
            }'
        ;;

    up)
        wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 1%+
        ;;

    down)
        wpctl set-volume @DEFAULT_AUDIO_SINK@ 1%-
        ;;

    mute|toggle)
        wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
        ;;

    set)
        if [[ "$2" =~ ^[0-9]+%$ ]]; then
            wpctl set-volume @DEFAULT_AUDIO_SINK@ "$2"
        else
            printf 'Usage: %s set <percentage>\n' "$0" >&2
            exit 1
        fi
        ;;

    *)
        printf 'Usage: %s {status|up|down|mute|toggle|set}\n' "$0" >&2
        exit 1
        ;;
esac
