#!/usr/bin/env bash

case "$1" in
    status|"")
        ssid=$(nmcli -t -f ACTIVE,SSID dev wifi 2>/dev/null |
            awk -F: '$1 == "yes" {print $2; exit}')

        if [ -n "$ssid" ]; then
            printf '%s\n' "$ssid"
        else
            printf '%s\n' "Disconnected"
        fi
        ;;

    on)
        nmcli networking on
        ;;

    off)
        nmcli networking off
        ;;

    toggle)
        if [ "$(nmcli networking)" = "enabled" ]; then
            nmcli networking off
        else
            nmcli networking on
        fi
        ;;

    wifi)
        nmcli radio wifi
        ;;

    wifi-on)
        nmcli radio wifi on
        ;;

    wifi-off)
        nmcli radio wifi off
        ;;

    wifi-toggle)
        if [ "$(nmcli radio wifi)" = "enabled" ]; then
            nmcli radio wifi off
        else
            nmcli radio wifi on
        fi
        ;;

    *)
        printf 'Usage: %s {status|on|off|toggle|wifi|wifi-on|wifi-off|wifi-toggle}\n' "$0" >&2
        exit 1
        ;;
esac
