{
  "layer": "top",
  "position": "top",
  "margin-left": 5,
  "margin-right": 5,
  "margin-top": 5,
  "height": 15,
  "modules-left": [
    "sway/workspaces",
    "sway/window"
  ],
  "modules-center": [
    "mpris",
    "clock",
    "custom/date",
    "custom/launcher"
  ],
  "modules-right": [
    "tray",
    "custom/notifications",
    "custom/clipboard",
    "network",
    "bluetooth",
    "wireplumber",
    "backlight",
    "battery",
    "custom/power"
  ],


  "custom/launcher": {
    "format": "Apps",
    "on-click": "pgrep -x fuzzel && pkill -x fuzzel || fuzzel --no-exit-on-keyboard-focus-loss",
    "tooltip": false
  },


  "custom/clipboard": {
    "format": "Clip: {}",
    "exec": "cliphist list | wc -l",
    "interval": 2,
    "on-click": "pidof fuzzel && pkill fuzzel || cliphist list | fuzzel --dmenu --no-exit-on-keyboard-focus-loss | cliphist decode | wl-copy",
    "on-click-right": "cliphist wipe && wl-copy -c",
    "tooltip": false
  },


  "custom/notifications": {
    "format": "Notif",
    "on-click": "pidof fuzzel && pkill fuzzel || makoctl history | fuzzel --dmenu --no-exit-on-keyboard-focus-loss",
    "on-click-right": "makoctl dismiss --all",
    "tooltip": false
  },


  "sway/workspaces": {
    "disable-scroll": false,
    "all-outputs": true,
    "format": "{name}"
  },


  "sway/window": {
    "max-length": 50,
    "format": "{}"
  },


  "tray": {
    "spacing": 10
  },


  "network": {
    "format-wifi": "Net: connected",
    "format-disconnected": "net: disconnected",
    "format-disabled": "net: off",
    "tooltip": false,
    "on-click": "nmcli radio wifi $([ $(nmcli radio wifi) = 'enabled' ] && echo 'off' || echo 'on')",
    "on-click-right": "pgrep -x nmtui && pkill -x nmtui || foot -e nmtui",
    "tooltip": false
  },


  "bluetooth": {
    "format": "Blt: {status}",
    "format-connected": "bt: connected",
    "format-disabled": "bt: off",
    "on-click": "bluetoothctl power $(bluetoothctl show | grep -q 'Powered: yes' && echo off || echo on)",
    "on-click-right": "pgrep -x bluetui && pkill -x bluetui || foot -e bluetui",
    "tooltip": false
  },


  "mpris": {
    "format": "Media: Playing",
    "format-paused": "Media: Paused",
    "max-length": 35,
    "on-click": "pidof fuzzel && pkill fuzzel || { media=$(playerctl metadata --format '{{artist}} - {{title}}' 2>/dev/null); status=$(playerctl status 2>/dev/null); [ \"$status\" = \"Playing\" ] && pp=\"⏸ Pause\" || pp=\"▶ Play\"; choice=$(echo -e \"$media\\n$pp\\n⏭ Next\\n⏮ Previous\" | fuzzel --dmenu --no-exit-on-keyboard-focus-loss); case \"$choice\" in *Pause|*Play) playerctl play-pause ;; '⏭ Next') playerctl next ;; '⏮ Previous') playerctl previous ;; *) [ -n \"$choice\" ] && true ;; esac }",
    "on-click-right": "playerctl play-pause",
    "tooltip": false
  },


  "wireplumber": {
    "format": "Vol: {volume}%",
    "format-muted": "vol: muted",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "scroll-step": 1,
    "tooltip": false
  },


  "backlight": {
    "format": "Bri: {percent}%",
    "scroll-step": 1,
    "tooltip": false
  },


  "battery": {
    "format": "Bat: {capacity}%",
    "on-click": "pidof fuzzel && pkill fuzzel || { profile=$(powerprofilesctl get); choice=$(echo -e 'Performance\\nBalanced\\nPower Saver' | fuzzel --dmenu --no-exit-on-keyboard-focus-loss); case \"$choice\" in 'Performance') powerprofilesctl set performance ;; 'Balanced') powerprofilesctl set balanced ;; 'Power Saver') powerprofilesctl set power-saver ;; esac; }",
    "tooltip": false
  },


  "custom/power": {
    "format": "Pwr",
    "on-click": "pidof fuzzel && pkill fuzzel || echo -e 'lock\\nlogout\\nreboot\\nshutdown' | fuzzel --dmenu --no-exit-on-keyboard-focus-loss | xargs -I {} sh -c 'case \"{}\" in lock) swaylock -c 000000 --ring-color ffffff --ring-ver-color ffffff --ring-wrong-color ffffff --ring-clear-color ffffff --inside-color 000000 --inside-ver-color 000000 --inside-wrong-color 000000 --inside-clear-color 000000 --key-hl-color ffffff --bs-hl-color ffffff --text-color ffffff ;; logout) swaymsg exit ;; reboot) systemctl reboot ;; shutdown) systemctl poweroff ;; esac'",
    "tooltip": false
  },


  "clock": {
    "format": "{:%H:%M}",
    "tooltip": false
  },


  "custom/date": {
    "exec": "date +'%d-%m %a'",
    "interval": 60,
    "tooltip": false
  }
}
