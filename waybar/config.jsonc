{
  "layer": "top",
  "position": "top",

  "margin-left": 0,
  "margin-right": 0,
  "margin-top": 0,
  "height": 31,

  "modules-left": [
    "hyprland/workspaces",
    "custom/launcher",
    "clock",
    "custom/notifications",
    "custom/clipboard"
  ],

  "modules-center": [
    "mpris"
  ],

  "modules-right": [
    "tray",
    "network",
    "bluetooth",
    "wireplumber#mic",
    "wireplumber",
    "backlight",
    "battery",
    "custom/power"
  ],

  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "format": "{name}"
  },

  "mpris": {
    "format": "Media: ▶ {artist} - {title}",
    "format-paused": "Media: ⏸ {artist} - {title}",
    "format-stopped": "Media: Stopped",
    "max-length": 60,
    "ellipsis": "…",
    "tooltip": false,
    "on-click": "~/.local/bin/system-scripts/player play-pause",
  },

  "clock": {
    "format": "{:%H:%M / %d-%m %a}",
    "tooltip": false
  },

  "custom/launcher": {
    "format": "Apps",
    "on-click": "pgrep -x rofi && pkill -x rofi || rofi -show drun",
    "on-click-right": "pgrep -x rofi && pkill -x rofi || rofi -show window",
    "tooltip": false
  },

  "network": {
    "format-wifi": "Net: {essid}",
    "format-ethernet": "Net: connected",
    "format-disconnected": "Net: disconnected",
    "format-disabled": "Net: off",
    "tooltip": false,
    "on-click": "~/.local/bin/system-scripts/network toggle",
    "on-click-right": "foot -e nmtui"
  },

  "bluetooth": {
    "format": "BT: {status}",
    "format-connected": "BT: connected",
    "format-disabled": "BT: off",
    "tooltip": false,
    "on-click": "~/.local/bin/system-scripts/bluetooth toggle",
    "on-click-right": "foot -e bluetui"
  },

  "wireplumber": {
    "format": "Vol: {volume}%",
    "format-muted": "Vol: muted",
    "tooltip": false,
    "on-click": "~/.local/bin/system-scripts/volume toggle",
    "on-scroll-up": "~/.local/bin/system-scripts/volume up",
    "on-scroll-down": "~/.local/bin/system-scripts/volume down"
  },

  "wireplumber#mic": {
    "node-type": "Audio/Source",
    "format": "Mic: {volume}%",
    "format-muted": "Mic: muted",
    "tooltip": false,
    "on-click": "~/.local/bin/system-scripts/microphone toggle",
  },

  "backlight": {
    "format": "Bri: {percent}%",
    "tooltip": false,
    "on-scroll-up": "~/.local/bin/system-scripts/brightness up",
    "on-scroll-down": "~/.local/bin/system-scripts/brightness down"
  },

  "custom/notifications": {
    "interval": 2,
    "tooltip": false,
    "on-click": "~/.local/bin/menu-scripts/notification-menu.sh",
    "on-click-right": "makoctl dismiss --all"
  },

  "custom/clipboard": {
    "interval": 2,
    "tooltip": false,
    "on-click": "~/.local/bin/menu-scripts/clipboard-menu.sh",
    "on-click-right": "cliphist wipe && wl-copy -c"
  },

  "battery": {
    "format": "Bat: {capacity}%",
    "format-charging": "Bat: {capacity}%+",
    "format-full": "Bat: {capacity}%",
    "tooltip": false,
    "on-click": "~/.local/bin/menu-scripts/powerprofile-menu.sh"
  },

  "custom/power": {
    "format": "Pwr",
    "tooltip": false,
    "on-click": "~/.local/bin/menu-scripts/logout-menu.sh",
  },

  "tray": {
    "spacing": 10
  }
}
