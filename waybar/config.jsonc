{
  "layer": "top",
  "position": "top",

  "margin-left": 0,
  "margin-right": 0,
  "margin-top": 0,
  "height": 32,

  "modules-left": [
    "sway/workspaces",
    "mpris",
    "custom/notifications",
    "custom/clipboard"
  ],

  "modules-center": [
    "custom/launcher",
    "clock"
  ],

  "modules-right": [
    "tray",
    "network",
    "bluetooth",
    "wireplumber#mic",
    "wireplumber",
    "backlight",
    "battery",
    "custom/power"
  ],

  "sway/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "format": "{name}"
  },

  "mpris": {
    "format": "Media: ▶ {artist} - {title}",
    "format-paused": "Media: ⏸ {artist} - {title}",
    "format-stopped": "Media: Stopped",
    "max-length": 60,
    "ellipsis": "…",
    "tooltip": false,
    "on-click": "playerctl play-pause",
    "on-click-right": "~/.local/bin/scripts/player.sh",
    "tooltip": false
  },

  "clock": {
    "format": "{:%H:%M / %d-%m %a}",
    "tooltip": false
  },

  "custom/launcher": {
    "format": "Apps",
    "on-click": "pgrep -x rofi && pkill -x rofi || rofi -show drun",
    "on-click-right": "pgrep -x rofi && pkill -x rofi || rofi -show window",
    "tooltip": false
  },

  "network": {
    "format-wifi": "Net: {essid}",
    "format-ethernet": "Net: connected",
    "format-disconnected": "Net: disconnected",
    "format-disabled": "Net: off",
    "tooltip": false,
    "on-click": "~/.local/bin/scripts/network.sh",
    "on-click-right": "foot -e nmtui"
  },

  "bluetooth": {
    "format": "BT: {status}",
    "format-connected": "BT: connected",
    "format-disabled": "BT: off",
    "tooltip": false,
    "on-click": "~/.local/bin/scripts/bluetooth.sh",
    "on-click-right": "foot -e bluetui"
  },

  "wireplumber": {
    "format": "Vol: {volume}%",
    "format-muted": "Vol: muted",
    "tooltip": false,
    "on-click": "exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-scroll-up": "exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 1%+",
    "on-scroll-down": "exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 1%-"
  },

  "wireplumber#mic": {
    "node-type": "Audio/Source",
    "format": "Mic: {volume}%",
    "format-muted": "Mic: muted",
    "tooltip": false,
    "on-click": "exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
  },

  "backlight": {
    "format": "Bri: {percent}%",
    "tooltip": false,
    "on-scroll-up": "exec brightnessctl set 1%+",
    "on-scroll-down": "exec brightnessctl set 1%-"
  },

  "custom/clipboard": {
    "format": "Clip",
    "interval": 2,
    "tooltip": false,
    "on-click": "~/.local/bin/scripts/clip-menu.sh",
    "on-click-right": "cliphist wipe && wl-copy -c"
  },

  "custom/notifications": {
    "exec": "echo Notif",
    "interval": 2,
    "tooltip": false,
    "on-click": "~/.local/bin/scripts/notif-menu.sh",
    "on-click-right": "makoctl dismiss --all"
  },

  "battery": {
    "format": "Bat: {capacity}%",
    "format-charging": "Bat: {capacity}%+",
    "format-full": "Bat: {capacity}%",
    "tooltip": false,
    "on-click": "~/.local/bin/scripts/ppf-menu.sh"
  },

  "custom/power": {
    "format": "Pwr",
    "tooltip": false,
    "on-click": "~/.local/bin/scripts/logout-menu.sh",
  },

  "tray": {
    "spacing": 10
  }
}
