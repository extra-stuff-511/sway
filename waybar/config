{
  "layer": "top",
  "position": "top",
  "height": 26,
  "modules-left": [
    "sway/workspaces",
    "sway/window"
  ],
  "modules-center": [
    "custom/launcher",
    "clock"
  ],
  "modules-right": [
    "tray",
    "custom/notifications",
    "custom/clipboard",
    "network",
    "bluetooth",
    "wireplumber",
    "backlight",
    "battery",
    "custom/power"
  ],
  "clock": {
    "format": "{:%d-%m %a}",
    "tooltip": false
  },
  "custom/launcher": {
    "format": "apps",
    "on-click": "fuzzel --no-exit-on-keyboard-focus-loss",
    "tooltip": false
  },
  "sway/workspaces": {
    "disable-scroll": true,
    "all-outputs": false,
    "format": "{name}",
    "persistent-workspaces": [1, 2, 3, 4, 5]
  },
  "sway/window": {
    "format": "{}",
    "max-length": 40,
    "separate-outputs": true
  },
  "network": {
    "format": "nw",
    "format-disconnected": "nw:off",
    "on-click": "foot -a float-term -e nmtui",
    "tooltip": false
  },
  "bluetooth": {
    "format": "bt",
    "format-disabled": "bt:off",
    "on-click": "foot -a float-term -e bluetoothctl",
    "tooltip": false
  },
  "wireplumber": {
    "format": "vol:{volume}%",
    "format-muted": "vol:mut",
    "on-click": "foot -e pulsemixer",
    "tooltip": false
  },
  "backlight": {
    "format": "bl:{percent}%",
    "on-scroll-up": "brightnessctl set 5%+",
    "on-scroll-down": "brightnessctl set 5%-",
    "on-click": "foot -e brightnessctl set 50%",
    "tooltip": false
  },
  "battery": {
    "format": "bat:{capacity}%",
    "tooltip": false
  },
  "custom/notifications": {
    "format": "notif",
    "on-click": "makoctl list | fuzzel -d --no-exit-on-keyboard-focus-loss | xargs -I {} makoctl invoke {}",
    "on-click-right": "makoctl dismiss -a",
    "tooltip": false
  },
  "custom/clipboard": {
    "format": "clip",
    "on-click": "cliphist list | fuzzel -d --no-exit-on-keyboard-focus-loss | cliphist decode | wl-copy",
    "tooltip": false
  },
  "tray": {
    "icon-size": 12,
    "spacing": 8
  },
  "custom/power": {
    "format": "pwr",
    "on-click": "~/.config/fuzzel/logout-menu",
    "tooltip": false
  }
}




