#!/usr/bin/env bash

set -euo pipefail

readonly WL_COPY="$(command -v wl-copy || true)"
readonly WL_PASTE="$(command -v wl-paste || true)"
readonly CLIPHIST="$(command -v cliphist || true)"

usage() {
    cat <<EOF
Usage:
  clipboard copy
  clipboard paste
  clipboard history
  clipboard clear
  clipboard watch
EOF
}

require_command() {
    local command="$1"

    if ! command -v "$command" >/dev/null 2>&1; then
        echo "Error: '$command' is not installed or not in PATH." >&2
        exit 1
    fi
}

copy() {
    require_command wl-copy
    wl-copy
}

paste() {
    require_command wl-paste
    wl-paste
}

history() {
    require_command cliphist

    cliphist list
}

clear() {
    require_command cliphist

    cliphist wipe
}

watch() {
    require_command wl-paste
    require_command cliphist

    wl-paste \
        --type text \
        --watch cliphist store
}

case "${1:-}" in
    copy)
        copy
        ;;

    paste)
        paste
        ;;

    history)
        history
        ;;

    clear)
        clear
        ;;

    watch)
        watch
        ;;

    *)
        usage
        exit 1
        ;;
esac
